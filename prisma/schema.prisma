generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String
  slug        String     @unique
  descripcion String?
  imagenUrl   String?
  precioM2    Int?
  colores     String?
  productos   Producto[]
}

model Producto {
  id          String    @id @default(cuid())
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  imagenUrl   String?
}

model Cotizacion {
  id          String             @id @default(cuid())
  categoriaId String
  vanos       Json
  nombre      String
  telefono    String
  comuna      String?
  estado      String             @default("nueva")
  createdAt   DateTime           @default(now())
  imagenes    CotizacionImagen[]
}

model CotizacionImagen {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  url          String
}

model Proyecto {
  id        String   @id @default(cuid())
  titulo    String
  imagenUrl String
  destacado Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

model MensajeContacto {
  id            String   @id @default(cuid())
  nombre        String
  email         String
  tipoConsulta  String
  mensaje       String   @db.Text
  leido         Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model BlogPost {
  id         String   @id @default(cuid())
  titulo     String
  slug       String   @unique
  resumen    String
  contenido  String   @db.Text
  imagenUrl  String?
  publicado  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Testimonio {
  id        String   @id @default(cuid())
  nombre    String
  comuna    String?
  servicio  String?
  rating    Int      @default(5)
  texto     String   @db.Text
  createdAt DateTime @default(now())
}

model AntesDespues {
  id             String   @id @default(cuid())
  titulo         String
  imagenAntesUrl String
  imagenDespuesUrl String
  createdAt      DateTime @default(now())
}

model Faq {
  id         String @id @default(cuid())
  pregunta   String
  respuesta  String @db.Text
  orden      Int    @default(0)
}

model SiteContent {
  id               String @id @default("main")
  nosotrosIntro    String @db.Text
  aniosExperiencia String
  proyectos        String
  coberturaZona    String
  garantia         String
  coberturaTexto   String @db.Text
}
